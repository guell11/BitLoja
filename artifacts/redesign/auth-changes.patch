+  }
+
+  .auth-visual {
+    min-height: 170px;
+    padding: 18px 19px 16px;
+  }
+
+  .auth-brand {
+    gap: 8px;
+    font-size: 19px;
+  }
+
+  .auth-brand .brand-mark {
+    width: 34px;
+    height: 34px;
+    font-size: 17px;
+  }
+
+  .auth-visual-copy {
+    margin-top: 11px;
+  }
+
+  .auth-visual-copy h2 {
+    font-size: 23px;
+  }
+
+  .auth-art {
+    right: 14px;
+    bottom: 7px;
+    width: 103px;
+    max-height: 130px;
+  }
+
+  .auth-content {
+    padding: 22px 19px 24px;
+  }
+
+  .auth-tabs {
+    margin-bottom: 19px;
+  }
+
+  .auth-form-heading {
+    margin-bottom: 20px;
+  }
+
+  .auth-form {
+    gap: 14px;
+  }
+
+  .auth-form .input {
+    min-height: 50px;
+  }
+}
+
+@media (max-height: 720px) and (max-width: 760px) {
+  .auth-visual {
+    min-height: 148px;
+    padding-block: 15px 12px;
+  }
+
+  .auth-visual-copy {
+    margin-top: 7px;
+  }
+
+  .auth-kicker {
+    display: none;
+  }
+
+  .auth-art {
+    width: 88px;
+    max-height: 112px;
+  }
+
+  .auth-content {
+    padding-block: 18px 21px;
+  }
+
+  .auth-tabs {
+    margin-bottom: 16px;
+  }
+
+  .auth-form-heading {
+    margin-bottom: 15px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .auth-modal *,
+  .auth-modal *::before,
+  .auth-modal *::after {
+    scroll-behavior: auto;
+    transition-duration: .01ms !important;
+    animation-duration: .01ms !important;
+  }
+}
