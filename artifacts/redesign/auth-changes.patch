diff --git a/static/css/auth.css b/static/css/auth.css
new file mode 100644
index 0000000..bfaf602
--- /dev/null
+++ b/static/css/auth.css
@@ -0,0 +1,565 @@
+.auth-wrap {
+  padding: 24px;
+}
+
+.auth-modal {
+  position: relative;
+  width: min(960px, 100%);
+  max-height: min(90vh, 900px);
+  overflow: auto;
+  border: 1px solid rgba(255, 255, 255, .48);
+  border-radius: 20px;
+  background: #fff;
+  color: var(--navy);
+  scrollbar-width: thin;
+  scrollbar-color: #aab9cc transparent;
+}
+
+.auth-modal > .modal-head {
+  position: absolute;
+  z-index: 3;
+  top: 15px;
+  right: 15px;
+  display: grid;
+  width: 42px;
+  height: 42px;
+  min-height: 0;
+  padding: 0;
+  border: 0;
+  pointer-events: none;
+}
+
+.auth-modal > .modal-head h2 {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.auth-modal .modal-close {
+  width: 42px;
+  height: 42px;
+  border-color: rgba(0, 17, 68, .12);
+  border-radius: 50%;
+  background: #fff;
+  color: var(--navy);
+  font-size: 15px;
+  pointer-events: auto;
+  transition: background .18s ease, border-color .18s ease, transform .18s ease;
+}
+
+.auth-modal .modal-close:hover {
+  transform: rotate(90deg);
+  border-color: rgba(0, 165, 244, .36);
+  background: #eff9ff;
+}
+
+.auth-modal > .modal-body {
+  padding: 0;
+}
+
+.auth-layout {
+  display: grid;
+  min-height: min(690px, 90vh);
+  grid-template-columns: minmax(290px, .84fr) minmax(0, 1.16fr);
+}
+
+.auth-visual {
+  position: relative;
+  display: flex;
+  min-width: 0;
+  flex-direction: column;
+  overflow: hidden;
+  padding: 30px 32px 26px;
+  background: linear-gradient(150deg, #006da8 0%, #00639d 52%, #00548f 100%);
+  color: #fff;
+  isolation: isolate;
+}
+
+.auth-visual::before {
+  position: absolute;
+  z-index: -1;
+  right: -142px;
+  bottom: 68px;
+  width: 370px;
+  height: 370px;
+  border: 1px solid rgba(255, 255, 255, .15);
+  border-radius: 50%;
+  box-shadow: 0 0 0 38px rgba(255, 255, 255, .035), 0 0 0 78px rgba(255, 255, 255, .025);
+  content: "";
+}
+
+.auth-brand {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  width: fit-content;
+  align-items: center;
+  gap: 10px;
+  color: #fff;
+  font-size: 21px;
+  font-weight: 900;
+  letter-spacing: -.045em;
+}
+
+.auth-brand .brand-mark {
+  width: 38px;
+  height: 38px;
+  border-radius: 11px;
+  background: #fff;
+  color: #008bd5;
+  box-shadow: 0 8px 18px rgba(0, 45, 94, .16);
+}
+
+.auth-visual-copy {
+  position: relative;
+  z-index: 1;
+  width: 100%;
+  margin-block: auto 0;
+  padding: 72px 0 224px;
+}
+
+.auth-kicker,
+.auth-form-kicker {
+  margin: 0;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .13em;
+  line-height: 1.4;
+  text-transform: uppercase;
+}
+
+.auth-kicker {
+  color: #fff;
+}
+
+.auth-visual-copy h2 {
+  max-width: 340px;
+  margin: 12px 0 14px;
+  font-size: clamp(34px, 4vw, 44px);
+  font-weight: 850;
+  letter-spacing: -.075em;
+  line-height: .99;
+}
+
+.auth-visual-copy > p:last-child {
+  max-width: 290px;
+  margin: 0;
+  color: #fff;
+  font-size: 13px;
+  line-height: 1.55;
+}
+
+.auth-art {
+  position: absolute;
+  z-index: 0;
+  right: 17px;
+  bottom: 52px;
+  width: min(64%, 238px);
+  max-height: 245px;
+  object-fit: contain;
+  filter: drop-shadow(0 18px 28px rgba(0, 36, 80, .2));
+}
+
+.auth-back {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  width: fit-content;
+  min-height: 36px;
+  align-items: center;
+  gap: 9px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: #fff;
+  font-size: 12px;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.auth-back:hover {
+  color: #fff;
+}
+
+.auth-back .bi {
+  font-size: 14px;
+  transition: transform .18s ease;
+}
+
+.auth-back:hover .bi {
+  transform: translateX(-3px);
+}
+
+.auth-content {
+  display: flex;
+  min-width: 0;
+  flex-direction: column;
+  justify-content: center;
+  padding: 56px clamp(34px, 5vw, 68px);
+  background: #fff;
+}
+
+.auth-tabs {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 4px;
+  margin: 0 0 26px;
+  padding: 4px;
+  border: 1px solid #e5ebf2;
+  border-radius: 12px;
+  background: #f1f5f9;
+}
+
+.auth-tab {
+  min-height: 43px;
+  border: 0;
+  border-radius: 9px;
+  background: transparent;
+  color: #53657e;
+  font-size: 12px;
+  font-weight: 800;
+  cursor: pointer;
+  transition: background .18s ease, color .18s ease, box-shadow .18s ease;
+}
+
+.auth-tab:hover:not(.active) {
+  color: var(--navy);
+  background: rgba(255, 255, 255, .68);
+}
+
+.auth-tab.active {
+  background: #fff;
+  color: var(--navy);
+  box-shadow: 0 2px 8px rgba(0, 24, 65, .09);
+}
+
+.auth-form-heading {
+  margin-bottom: 24px;
+}
+
+.auth-form-kicker {
+  color: #006da8;
+}
+
+.auth-form-heading h2 {
+  margin: 8px 0 6px;
+  color: var(--navy);
+  font-size: clamp(25px, 3vw, 31px);
+  font-weight: 850;
+  letter-spacing: -.065em;
+  line-height: 1.1;
+}
+
+.auth-form-heading > p:last-child {
+  max-width: 390px;
+  margin: 0;
+  color: #5f7088;
+  font-size: 13px;
+  line-height: 1.55;
+}
+
+.auth-form {
+  display: grid;
+  gap: 17px;
+  width: 100%;
+}
+
+.auth-form .field {
+  min-width: 0;
+  margin: 0;
+}
+
+.auth-form .field label {
+  margin-bottom: 7px;
+  color: #233a60;
+  font-size: 12px;
+  font-weight: 750;
+}
+
+.auth-form .input {
+  width: 100%;
+  min-height: 52px;
+  padding: 12px 14px;
+  border: 1px solid #d4deea;
+  border-radius: 10px;
+  background-color: #fff;
+  color: var(--navy);
+  font-size: 14px;
+  outline: 0;
+  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
+}
+
+.auth-form .input::placeholder {
+  color: #66758c;
+}
+
+.auth-form .input:hover:not(:focus) {
+  border-color: #b8c7d9;
+}
+
+.auth-form .input:focus {
+  border-color: #00a5f4;
+  box-shadow: 0 0 0 3px rgba(0, 165, 244, .15);
+}
+
+.auth-password-field {
+  position: relative;
+}
+
+.auth-password-field .input {
+  padding-right: 82px;
+}
+
+.auth-password-toggle {
+  position: absolute;
+  top: 50%;
+  right: 12px;
+  min-height: 34px;
+  padding: 0 5px;
+  transform: translateY(-50%);
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: #006da8;
+  font-size: 11px;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+.auth-password-toggle:hover:not(:disabled) {
+  color: var(--navy);
+  background: #eff9ff;
+}
+
+.auth-help {
+  display: block;
+  margin-top: 7px;
+  color: #64748b;
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+.auth-feedback {
+  margin: 0;
+  color: #60728d;
+  font-size: 12px;
+  line-height: 1.45;
+}
+
+.auth-feedback:empty {
+  display: none;
+}
+
+.auth-feedback.error {
+  padding: 10px 12px;
+  border: 1px solid #f2c4ca;
+  border-radius: 9px;
+  background: #fff4f5;
+  color: #a21f32;
+}
+
+.auth-modal .auth-submit {
+  width: 100%;
+  min-height: 52px;
+  margin-top: 2px;
+  padding-inline: 18px;
+  border: 1px solid var(--navy);
+  border-radius: 10px;
+  background: var(--navy);
+  color: #fff;
+  font-size: 12px;
+  font-weight: 850;
+  letter-spacing: .035em;
+  box-shadow: 0 9px 18px rgba(0, 11, 53, .15);
+  transition: background .18s ease, box-shadow .18s ease, transform .18s ease;
+}
+
+.auth-modal .auth-submit:hover:not(:disabled) {
+  transform: translateY(-1px);
+  background: #10204c;
+  box-shadow: 0 12px 22px rgba(0, 11, 53, .2);
+}
+
+.auth-modal .auth-submit:disabled {
+  opacity: .72;
+  cursor: progress;
+}
+
+.auth-modal :focus-visible {
+  outline: 3px solid #008bd5;
+  outline-offset: 2px;
+  box-shadow: 0 0 0 5px rgba(0, 165, 244, .15);
+}
+
+@media (max-width: 760px) {
+  .auth-wrap {
+    padding: 12px;
+  }
+
+  .auth-modal {
+    width: min(560px, 100%);
+    max-height: calc(100dvh - 24px);
+    border-radius: 17px;
+  }
+
+  .auth-modal > .modal-head {
+    top: 13px;
+    right: 13px;
+  }
+
+  .auth-layout {
+    min-height: 0;
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .auth-visual {
+    min-height: 184px;
+    padding: 20px 23px 18px;
+  }
+
+  .auth-visual-copy {
+    width: min(68%, 260px);
+    margin: 12px 0 0;
+    padding: 0;
+  }
+
+  .auth-visual-copy h2 {
+    margin: 5px 0 0;
+    font-size: 25px;
+    line-height: 1.02;
+  }
+
+  .auth-visual-copy > p:last-child,
+  .auth-back {
+    display: none;
+  }
+
+  .auth-kicker {
+    font-size: 8px;
+  }
+
+  .auth-art {
+    right: 22px;
