+    padding: 25px 25px 29px;
+  }
+
+  .auth-tabs {
+    margin-bottom: 22px;
+  }
+}
+
+@media (max-width: 430px) {
+  .auth-wrap {
+    padding: 9px;
+  }
+
+  .auth-modal {
