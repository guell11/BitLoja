+                   VALUES(?,?,?,?,?,'draft',?,?,?,?,?,?,?,?)""",
+                (g.user["id"], wallet["id"], idem, request_hash, ref, destination, amount_sats, fee_sats, total_in, psbt,
+                 json.dumps(body, sort_keys=True), _now(), _now()),
