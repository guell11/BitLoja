+.modal .actions .button{flex:0 0 auto}
+.modal .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
+.toast-stack{position:fixed;right:18px;bottom:18px;z-index:200;display:grid;gap:8px;max-width:min(360px,calc(100% - 36px))}
+.toast{padding:12px 15px;border:1px solid rgba(255,255,255,.35);border-radius:11px;background:var(--navy);color:#fff;box-shadow:var(--shadow);animation:toast-in .2s ease}
