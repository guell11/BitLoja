+.modal .keybox,.modal .address{background:#edf6fc;border-color:#b9d1e5;color:#123050}
+.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border-radius:9px;background:#e9f1f8;margin-bottom:16px}
