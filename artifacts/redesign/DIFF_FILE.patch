+                {"add_inputs": True, "includeWatching": True, "lockUnspents": True,
+                 "minconf": max(1, int(self.ctx["MIN_CONFIRMATIONS"])), "changeAddress": change,
+                 "fee_rate": float(self.ctx["PSBT_FEE_RATE"])}, True])
+            psbt = funded["psbt"]
