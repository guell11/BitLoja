+  overflow: auto;
+  border: 1px solid rgba(255, 255, 255, .48);
+  border-radius: 20px;
+  background: #fff;
+  color: var(--navy);
+  scrollbar-width: thin;
+  scrollbar-color: #aab9cc transparent;
+}
+
+.auth-modal > .modal-head {
+  position: absolute;
+  z-index: 3;
+  top: 15px;
+  right: 15px;
+  display: grid;
+  width: 42px;
+  height: 42px;
+  min-height: 0;
+  padding: 0;
+  border: 0;
+  pointer-events: none;
+}
+
+.auth-modal > .modal-head h2 {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
